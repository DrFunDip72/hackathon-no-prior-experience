{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/parse-resume.ts": { "maxDuration": 60 },
    "api/rank-events.ts": { "maxDuration": 30 },
    "api/calendar.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/calendar.ics", "destination": "/api/calendar" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
